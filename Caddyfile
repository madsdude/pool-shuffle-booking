{
  auto_https off
}

:80, :443 {
  encode zstd gzip
  root * /srv/static

  # Staff-oversigten: altid staff.html ved /staff
  handle_path /staff* {
    rewrite * /staff.html
    file_server
  }

  # API-proxy (valgfri) — hvis du vil serve API på samme host uden CORS.
  @api path /api/*  # FastAPI kører i "booking" containeren på port 8000
  reverse_proxy @api booking:8000

  # Alt andet: statiske filer (fallback til index.html)
  handle {
    try_files {path} {path}/ /public-booking.html
    file_server
  }
}
