{
  email admin@poolhall.dk
}

poolhall.dk, www.poolhall.dk {
  encode zstd gzip

  route {
    # API først (bevar stien – IKKE handle_path)
    handle /api* {
      reverse_proxy booking:8000
    }

    # Statics
    handle /static* {
      root * /srv/static
      file_server
    }

    # Staff
    handle /staff* {
      root * /srv/static
      rewrite * /staff.html
      file_server
    }

    # Forside + fallback
    handle {
      root * /srv/static
      try_files {path} {path}/ /index.html /public-booking.html
      file_server
    }
  }
}
