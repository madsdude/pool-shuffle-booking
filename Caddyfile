{
  # Brug dit rigtige ACME-mail til certs
  email admin@poolhall.dk
}

# Fælles indstillinger (kompression + sikkerhedsheaders)
(poolhall_common) {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer-when-downgrade"
    Permissions-Policy "interest-cohort=()"
    Content-Security-Policy "upgrade-insecure-requests"
  }
}

# WWW -> apex
www.poolhall.dk {
  import poolhall_common
  redir https://poolhall.dk{uri} 308
}

# Hovedsite
poolhall.dk {
  import poolhall_common

  # API først (ellers rammer de statiske regler)
  @api path /api* /docs* /openapi.json
  reverse_proxy @api booking:8000

  # Statiske filer (js/css/img) under /static
  handle_path /static* {
    root * /srv/static
    file_server
  }

  # Staff-oversigt – skal VISE staff.html
  handle_path /staff* {
    root * /srv/static
    rewrite * /staff.html
    file_server
  }

  # Alt andet = forside (fallback til index.html; hvis den ikke findes, brug public-booking.html)
  handle {
    root * /srv/static
    try_files {path} {path}/ /index.html /public-booking.html
    file_server
  }
}
