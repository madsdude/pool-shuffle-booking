{
  email admin@poolhall.dk
}

poolhall.dk, www.poolhall.dk {
  encode zstd gzip

  route {
    # 1) API først — BRUG "handle" (ikke handle_path), så /api/resources bevares
    handle /api* {
      reverse_proxy booking:8000
    }

    # 2) Statics
    handle /static* {
      root * /srv/static
      file_server
    }

    # 3) Staff -> staff.html
    handle /staff* {
      root * /srv/static
      rewrite * /staff.html
      file_server
    }

    # 4) Forside + alt andet -> index.html (fallback)
    handle {
      root * /srv/static
      try_files {path} {path}/ /index.html /public-booking.html
      file_server
    }
  }
}
